@inherits LayoutComponentBase
@inject IJSRuntime JS

<div class="d-flex min-vh-100 flex-column">
    <header class="sticky-top site-header">
        <nav class="navbar navbar-expand">
            <div class="container-xl">
                <NavLink class="navbar-brand"
                         href=""
                         Match="NavLinkMatch.All">
                    Loom
                </NavLink>

                <div class="navbar-nav flex-row gap-1">
                    <NavLink class="nav-link"
                             href=""
                             Match="NavLinkMatch.All">
                        Home
                    </NavLink>

                    <NavLink class="nav-link"
                             href="playground">
                        Playground
                    </NavLink>

                    <a class="nav-link d-none d-sm-flex"
                       href="https://github.com/rbx-loom/loom"
                       target="_blank"
                       rel="noopener noreferrer">
                        GitHub
                    </a>
                </div>

                <button class="btn theme-toggle ms-auto"
                        type="button"
                        aria-label="Toggle light and dark mode"
                        title="Toggle theme"
                        @onclick="ToggleThemeAsync">
                    <span class="light-icon" aria-hidden="true">☀</span>
                    <span class="dark-icon" aria-hidden="true">☾</span>
                </button>
            </div>
        </nav>
    </header>

    <main class="container-xl flex-grow-1">
        <span id="page-focus-target"
              class="visually-hidden"
              tabindex="-1">
            Page loaded
        </span>

        @Body
    </main>
</div>

@code {
    private async Task ToggleThemeAsync()
    {
        await JS.InvokeVoidAsync("loomTheme.toggle");
    }
}
