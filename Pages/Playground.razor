@page "/playground"
@implements IAsyncDisposable

@using Microsoft.JSInterop
@using RbxLoom.Web.Services

@inject IJSRuntime JS
@inject LoomPlaygroundCompiler Compiler

<PageTitle>Playground — Loom</PageTitle>

<section class="py-5">
    <header class="mb-4">
        <div class="d-flex flex-column flex-sm-row
                    align-items-sm-end justify-content-between gap-3">
            <div>
                <h1 class="mb-1">Playground</h1>
                <p class="mb-0 text-secondary">
                    Compile Loom to Luau directly in your browser.
                </p>
            </div>

            <div class="compile-status"
                 role="status"
                 aria-live="polite">
                @if (isCompiling)
                {
                    <span class="spinner-border spinner-border-sm me-2"
                          aria-hidden="true">
                    </span>
                    <span>Compiling…</span>
                }
                else if (hasCompiled)
                {
                    <span>Compiled automatically</span>
                }
                else
                {
                    <span>Waiting for editor…</span>
                }
            </div>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(compilerFailure))
    {
        <div class="alert alert-danger"
             role="alert">
            @compilerFailure
        </div>
    }

    <div class="row g-3 editor-row">
        <div class="col-12 col-lg-6 d-flex">
            <section class="card editor-card w-100">
                <header class="card-header">
                    Loom
                </header>

                <div class="card-body p-0 editor-container">
                    <div id="loom-source-editor"
                         class="editor">
                    </div>
                </div>
            </section>
        </div>

        <div class="col-12 col-lg-6 d-flex">
            <section class="card editor-card w-100">
                <header class="card-header">
                    Generated Luau
                </header>

                <div class="card-body p-0 editor-container">
                    <div id="loom-output-editor"
                         class="editor">
                    </div>
                </div>
            </section>
        </div>
    </div>

    @if (diagnostics.Count > 0)
    {
        <section class="card mt-3">
            <div class="card-header">
                <h2 class="h6 mb-0">Diagnostics</h2>
            </div>

            <div class="list-group list-group-flush">
                @foreach (var diagnostic in diagnostics)
                {
                    <div class="list-group-item diagnostic-item">
                        <div class="d-flex flex-column
                                    flex-sm-row gap-1 gap-sm-3">
                            <strong class="text-capitalize">
                                @diagnostic.Severity
                            </strong>

                            <span>
                                Line @diagnostic.StartLineNumber,
                                column @diagnostic.StartColumn:
                                @diagnostic.Message
                            </span>
                        </div>
                    </div>
                }
            </div>
        </section>
    }
</section>

@code {
    private const string InitialSource =
        """
        declare fn print(message: unknown): void;

        fn greet(name: string) {
            print("Hello, " + name + "!");
        }

        greet("world");
        """;

    private DotNetObjectReference<Playground>? objectReference;

    private bool initialized;
    private bool isCompiling;
    private bool hasCompiled;
    private bool disposed;

    private long requestedCompilation;
    private long appliedCompilation;

    private string? compilerFailure;

    private IReadOnlyList<PlaygroundDiagnostic> diagnostics =
        Array.Empty<PlaygroundDiagnostic>();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            objectReference = DotNetObjectReference.Create(this);

            await JS.InvokeVoidAsync(
                "loomPlayground.initialize",
                "loom-source-editor",
                "loom-output-editor",
                InitialSource,
                objectReference);

            initialized = true;

            await CompileSourceAsync(InitialSource);
        }
        catch (Exception exception)
        {
            compilerFailure =
                $"Editor initialization failed: {exception.Message}";

            Console.Error.WriteLine(exception);
            StateHasChanged();
        }
    }

    [JSInvokable]
    public async Task SourceChangedAsync(string source)
    {
        if (!initialized || disposed)
        {
            return;
        }

        await CompileSourceAsync(source);
    }

    private async Task CompileSourceAsync(string source)
    {
        var compilationId = Interlocked.Increment(
            ref requestedCompilation);

        isCompiling = true;
        compilerFailure = null;

        await InvokeAsync(StateHasChanged);

        try
        {
            var result = Compiler.Compile(source);

            // Do not apply an older result after a newer edit.
            if (compilationId < Volatile.Read(
                    ref requestedCompilation))
            {
                return;
            }

            diagnostics = result.Diagnostics;
            compilerFailure = result.CompilerFailure;

            var output = GetOutput(result);

            await JS.InvokeVoidAsync(
                "loomPlayground.setOutput",
                output);

            await JS.InvokeVoidAsync(
                "loomPlayground.setDiagnostics",
                result.Diagnostics);

            appliedCompilation = compilationId;
            hasCompiled = true;
        }
        catch (JSDisconnectedException)
        {
            // The page was closed or navigation occurred.
        }
        catch (Exception exception)
        {
            if (compilationId < Volatile.Read(
                    ref requestedCompilation))
            {
                return;
            }

            compilerFailure =
                $"{exception.GetType().Name}: {exception.Message}";

            Console.Error.WriteLine(exception);

            try
            {
                await JS.InvokeVoidAsync(
                    "loomPlayground.setOutput",
                    $"-- Playground failure\n-- {compilerFailure}");
            }
            catch (JSDisconnectedException)
            {
            }
        }
        finally
        {
            if (compilationId >= Volatile.Read(
                    ref requestedCompilation))
            {
                isCompiling = false;
            }

            if (!disposed)
            {
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private static string GetOutput(
        PlaygroundCompilationResult result)
    {
        if (!string.IsNullOrWhiteSpace(result.CompilerFailure))
        {
            return
                $"-- Compiler failure\n-- {result.CompilerFailure}";
        }

        if (!string.IsNullOrWhiteSpace(result.Output))
        {
            return result.Output;
        }

        if (result.Diagnostics.Count > 0)
        {
            return "-- Compilation failed. See diagnostics in editor panel.";
        }

        return
            "-- Compilation completed, but no Luau was generated.";
    }

    public async ValueTask DisposeAsync()
    {
        disposed = true;

        if (initialized)
        {
            try
            {
                await JS.InvokeVoidAsync(
                    "loomPlayground.dispose");
            }
            catch (JSDisconnectedException)
            {
            }
        }

        objectReference?.Dispose();
    }
}
